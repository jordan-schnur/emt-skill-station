{
  "name": "nremt-study-tool",
  "version": "1.0.0",
  "description": "NREMT Skill Sheet Trainer with spaced repetition and drills",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "test:srs": "jest srs.test.js --coverage",
    "test:storage": "jest storage.test.js --coverage",
    "test:views": "jest views.test.js --coverage",
    "test:e2e": "jest --testMatch='**/*.e2e.test.js'",
    "test:e2e:browser": "bash scripts/check-playwright.sh",
    "test:playwright:install": "npx playwright install",
    "test:all": "jest --coverage --verbose",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:legacy": "jest --coverage --watchAll=false",
    "test:ci": "npm run test:legacy && npm run test:unit && npm run test:playwright:install && npm run test:e2e:browser",
    "serve": "python3 -m http.server 8000",
    "preprocess": "python3 preprocess.py"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.20.0",
    "@playwright/test": "^1.40.0",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-jest": "^29.3.0",
    "jest": "^29.3.0",
    "jest-environment-jsdom": "^29.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "preact": "^10.29.2"
  }
}
