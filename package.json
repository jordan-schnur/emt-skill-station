{
  "name": "nremt-study-tool",
  "version": "1.0.0",
  "description": "NREMT Skill Sheet Trainer with spaced repetition and drills",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e:browser": "playwright test",
    "test:playwright:install": "playwright install --with-deps",
    "test:ci": "vitest run --coverage && playwright test",
    "serve": "python3 -m http.server 8000",
    "test:e2e:staging": "BASE_URL=http://jordanschnur.com/emt-skill-station/staging/ playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@preact/signals": "^2.9.0",
    "firebase": "^12.13.0",
    "preact": "^10.29.2"
  }
}
